{
  "$schema": "./contract.schema.json",
  "meta": {
    "game": "articleblitz",
    "config_version": "0.3.0",
    "players": ["djm", "durracktu"],
    "status": "draft"
  },
  "models": {
    "harness": {
      "jury_panel": [
        { "model": "claude-sonnet-5", "effort": "high" },
        { "model": "claude-sonnet-5", "effort": "high" },
        { "model": "claude-sonnet-5", "effort": "high" }
      ],
      "adjudicator": { "model": "claude-opus-4-8", "effort": "xhigh" },
      "appeals": { "model": "claude-opus-4-8", "effort": "xhigh" },
      "rerun": "@original",
      "calibration": { "model": "claude-sonnet-5", "effort": "low" },
      "telemetry": { "model": "claude-haiku-4-5", "effort": "low" },
      "report_stats": { "model": "claude-sonnet-5", "effort": "low" },
      "report_replay": { "model": "claude-opus-4-8", "effort": "high" }
    },
    "pool": {
      "min_cost_tiers": 3,
      "fable_legal": false,
      "candidates": ["claude-haiku-4-5", "claude-sonnet-5", "claude-opus-4-8"]
    }
  },
  "phases": [
    { "id": 0, "name": "draft", "actors": ["human"], "gate": "both players' pool suggestions submitted" },
    { "id": 1, "name": "preference_calibration", "actors": ["human", "harness.calibration"], "gate": "both participant profiles generated" },
    { "id": 2, "name": "candidate_pool", "actors": ["code"], "gate": "pool_size execution configurations published" },
    { "id": 3, "name": "ban_phase", "actors": ["human", "harness.telemetry"], "gate": "alternating bans complete; finalists configurations remain" },
    { "id": 4, "name": "betting_phase", "actors": ["human", "harness.telemetry"], "gate": "both players' priors recorded" },
    { "id": 5, "name": "assignment_lottery", "actors": ["code"], "gate": "assignments generated by assignment_method" },
    { "id": 6, "name": "prompt_budget", "actors": ["human", "code"], "gate": "both players' budget allocations committed" },
    { "id": 7, "name": "information_purchases", "actors": ["code"], "gate": "purchase window closed: both players pass or budget spent" },
    { "id": 8, "name": "execution", "actors": ["models.pool"], "gate": "all prompts executed; artifacts and telemetry captured" },
    { "id": 9, "name": "blind_jury", "actors": ["harness.jury_panel", "harness.adjudicator"], "gate": "all reviews submitted; disagreements adjudicated" },
    { "id": 10, "name": "human_appeals", "actors": ["human", "harness.appeals", "harness.rerun"], "gate": "challenge tokens exhausted or both players waive" },
    { "id": 11, "name": "final_report", "actors": ["harness.report_stats", "harness.report_replay"], "gate": "report delivered; game archived; retrospective opened" }
  ],
  "weights": {
    "jury": {
      "output_quality": 0.35,
      "evidence": 0.2,
      "citations": 0.1,
      "cost_efficiency": 0.15,
      "reproducibility": 0.1,
      "confidence_calibration": 0.1
    }
  },
  "params": {
    "pool_size": 8,
    "finalists": 5,
    "ban_order": ["djm", "durracktu"],
    "prompt_budget_points": 100,
    "challenge_tokens": 3,
    "assignment_method": "fully_random",
    "information_purchases": {
      "context_size": 10,
      "temperature": 10,
      "model_family": 25,
      "reasoning_depth": 15,
      "repository_count": 10,
      "evaluation_rubric": 30
    },
    "adjudication_trigger": { "type": "score_spread", "threshold": 3, "scale": 10 },
    "cache_jury_packets": true
  }
}
